DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tianji_ai_academy
DB_USERNAME=root
SPRING_PROFILES_ACTIVE=dev
DEV_SEED=false
DEMO_PASSWORD=CHANGE_ME_DEMO_ACCOUNT_PASSWORD
# Copy to .env, replace all CHANGE_ME values. Never commit .env.
DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_12_CHARACTERS
WEB_PORT=8088
DEMO_DATA=false
AI_ENABLED=false
AI_MODE=disabled
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=disabled
# Default: local lexical feature hashes, not neural embeddings.
EMBEDDING_MODE=lexical
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=local-lexical-hash-v1
# For remote mode, explicitly select a matching remote embedding model.
EMBEDDING_API_KEY=disabled
