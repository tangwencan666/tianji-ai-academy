SPRING_PROFILES_ACTIVE=dev
DEV_SEED=false
DEMO_PASSWORD=CHANGE_ME_DEMO_ACCOUNT_PASSWORD
# Copy to .env, replace all CHANGE_ME values. Never commit .env.
DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
